model Book {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  author      String
  isbn        String?  @unique
  rfidTag     String?  @unique
  category    String   @default("General")
  shelfNumber String?
  imageUrl    String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}