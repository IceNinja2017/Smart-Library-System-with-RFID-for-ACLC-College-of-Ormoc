model Book {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  author      String
  isbn        String?    @unique
  category    String     @default("General")
  shelfNumber String?
  imageUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  copies      BookCopy[]
}