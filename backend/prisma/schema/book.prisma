model Book {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  author      String
  isbn        String?   @unique
  synopsis    String?   @db.Text
  category    String    @default("General")
  shelfNumber String?
  imageUrl    String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  copies BookCopy[]
}
